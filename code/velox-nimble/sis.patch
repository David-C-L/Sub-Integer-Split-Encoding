+    std::array<uint32_t, kMaxBuckets> totals{};
+    for (uint32_t lane = 0; lane < kLanes; ++lane) {
+      for (uint32_t bucket = 0; bucket < numBuckets; ++bucket) {
+        totals[bucket] += laneCounts[lane][bucket];
