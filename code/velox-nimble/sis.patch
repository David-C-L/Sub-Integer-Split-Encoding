+      std::array<const uint8_t*, kLanes> tags;
+      std::array<physicalType*, kLanes> outputs;
+      for (uint32_t lane = 0; lane < kLanes; ++lane) {
+        const uint32_t index = firstFull + lane * laneBlocks + step;
