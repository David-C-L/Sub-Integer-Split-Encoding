+
+  auto containsType =
+      [](const std::vector<std::pair<nimble::EncodingType, float>>& factors,
+         nimble::EncodingType type) {
+        return std::any_of(
+            factors.begin(), factors.end(), [type](const auto& pair) {
+              return pair.first == type;
+            });
+      };
