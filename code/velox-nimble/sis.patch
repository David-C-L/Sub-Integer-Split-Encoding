+// Evaluation graph (OpenZLCompressionParameters::selectNumericGraph):
+//   serial -> interpret-as-LE(width) -> OpenZL's standard select_numeric
+// with no segmenter, as the openzl/auto benchmark arm compresses a column.
+// Integer types only; anything else keeps createGraph's graph.
+std::optional<openzl::GraphID> createSelectNumericGraph(
+    openzl::Compressor& compressor,
+    DataType dataType) {
+  size_t elementByteWidth = 0;
+  switch (dataType) {
+    case DataType::Int8:
+    case DataType::Uint8:
+      elementByteWidth = 1;
+      break;
+    case DataType::Int16:
+    case DataType::Uint16:
+      elementByteWidth = 2;
+      break;
+    case DataType::Int32:
+    case DataType::Uint32:
+      elementByteWidth = 4;
+      break;
+    case DataType::Int64:
+    case DataType::Uint64:
+      elementByteWidth = 8;
+      break;
+    default:
+      return std::nullopt;
+  }
+  openzl::nodes::ConvertSerialToNumLE toNumeric{
+      static_cast<int>(elementByteWidth)};
+  return toNumeric(
+      compressor,
+      static_cast<openzl::GraphID>(ZL_StandardGraphID_select_numeric));
+}
