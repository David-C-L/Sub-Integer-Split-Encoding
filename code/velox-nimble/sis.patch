+TEST(
+    SubIntSplitEncodingTests,
+    CreateImplExtendsCandidatesForSubIntSplitChildren) {
+  nimble::ManualEncodingSelectionPolicy<uint64_t> policy{
+      nimble::ManualEncodingSelectionPolicyFactory::
