+        selection, physicalValues, buffer, flaggedOptions, flaggedTuning);
+  } else {
+    return E::encode(selection, physicalValues, buffer, flaggedOptions);
+  }
 }
 
 } // namespace facebook::nimble::mlidc
 
+namespace facebook::nimble::test {
