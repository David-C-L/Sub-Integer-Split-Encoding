+template <typename CostFn>
+inline SelectorResult selectSplitsImpl(
+    const std::vector<uint64_t>& samples,
+    int kBits,
+    size_t fullCount,
+    const SelectorConfig& cfg,
+    CostFn&& costFn,
+    bool constantAllowed = true) {
