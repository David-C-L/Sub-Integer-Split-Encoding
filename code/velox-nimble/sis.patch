+
+// Returns a leaf pool of this target's own, so allocations are attributable
+// to it rather than pooled with every other arm in the sweep. A view's index
+// structures are allocated here, so they are measured rather than estimated.
+//
+// The leaf hangs off a root pool of its own rather than off addLeafPool()'s
+// default root. The default root tracks no usage unless
+// --velox_enable_memory_usage_track_in_default_memory_pool is set, and its
+// children inherit that, so usedBytes() on such a leaf is always zero and every
+// view arm would report its payload alone. A root from addRootPool() always
+// tracks usage. The leaf holds a reference to its parent, so the root lives
+// exactly as long as the target's pool.
+inline std::shared_ptr<velox::memory::MemoryPool> makeTargetPool() {
+  static std::atomic<size_t> nextId{0};
+  const auto name = "mlidc_target_" + std::to_string(nextId++);
+  auto root = velox::memory::memoryManager()->addRootPool(name);
+  return root->addLeafChild(name);
