+// The per-range cost function the split DP minimises, over `allowed` only.
+// Holds a reference to `allowed`, which must outlive it.
+inline auto restrictedSectionCostFn(
+    const AllowedEncodings& allowed,
+    const SelectorConfig& cfg,
+    std::vector<std::vector<SectionCandidate>>* candidateSink = nullptr) {
+  return [&allowed,
+          candidateSink,
+          allowHuffman = cfg.allowHuffman,
+          allowDeltaBlock = cfg.allowDeltaBlock,
+          weighting = cfg.decodeWeighting,
+          excluded = cfg.excludedEncodings,
+          costModelV2 = cfg.costModelV2,
+          sampleBlockSize = cfg.sampleBlockSize,
+          deltaCostModelV2 = cfg.deltaCostModelV2,
+          pricer = cfg.sectionSizePricer,
+          choicePricer = cfg.sectionChoicePricer](
+             const SectionMetrics& m,
+             size_t numValues,
+             size_t streamCount,
+             int bitWidth,
+             const std::vector<uint64_t>& segValues) noexcept {
+    if (choicePricer) {
+      // See SelectorConfig::sectionChoicePricer.
+      const SectionChoice choice = choicePricer(
+          std::span<const uint64_t>(segValues.data(), segValues.size()),
+          bitWidth,
+          streamCount);
+      SectionCost cell;
+      cell.sizeBits = choice.sizeBits;
+      cell.weightedBits = cell.sizeBits;
+      cell.decodeNanosPerRow = 0.0;
+      cell.encoding = choice.encoding;
+      cell.storeRaw = choice.storeRaw;
+      cell.rawGraph = choice.rawGraph;
+      return cell;
+    }
+    if (pricer) {
+      // See SelectorConfig::sectionSizePricer.
+      SectionCost cell;
+      cell.sizeBits = pricer(
+          std::span<const uint64_t>(segValues.data(), segValues.size()),
+          bitWidth,
+          streamCount);
+      cell.weightedBits = cell.sizeBits;
+      cell.decodeNanosPerRow = 0.0;
+      cell.encoding = EncodingType::Trivial;
+      return cell;
+    }
+    if (candidateSink == nullptr) {
+      return bestSectionCost(
+          m,
+          numValues,
+          streamCount,
+          bitWidth,
+          segValues,
+          allowed,
+          allowHuffman,
+          allowDeltaBlock,
+          weighting,
+          excluded,
+          costModelV2,
+          sampleBlockSize,
+          deltaCostModelV2);
