+  Buffer buffer{*pool_};
+  Encoding::Options options;
+  auto optionsTuning = subintsplit::kDefaultTuningConfig;
+  optionsTuning.autoTransform = true;
+  const auto chosen =
+      test::Encoder<SubIntSplitEncoding<uint64_t>>::encodeWithTuning(
+          buffer,
+          values,
+          optionsTuning,
+          CompressionType::Uncompressed,
+          options);
+
+  EXPECT_LE(chosen.size(), plain.size());
+
+  expectMaterializes(chosen, values, options);
