+      probeEncoded, Encoding::kPrefixSize, nullptr, nullptr, &probeInfo);
+  ASSERT_GE(probeSections.size(), 2u)
+      << "test needs a multi-section column so keySection=1 is valid; "
+      << "this shape produced only one section";
