+// Times an arm's planning inside its real encode: the factory is wrapped so
+// the clock starts immediately before the arm's encode and the plan observer
+// stamps the first plan the top-level SubIntSplit encode chooses.
+template <typename Elem>
+void timeArmPlanning(
+    const EncoderEntry<Elem>& encoder,
+    const Vector<Elem>& data,
+    CsvResultWriter& csv,
+    std::string_view driver,
+    const std::string& dataset) {
+  using Clock = std::chrono::steady_clock;
+  struct Probe {
+    Clock::time_point start;
+    Clock::time_point planned;
+    int calls{0};
+    std::string plan;
+  };
+  auto probe = std::make_shared<Probe>();
+  EncoderEntry<Elem> timed = encoder;
+  timed.factory = [probe, inner = encoder.factory](
+                      const Vector<Elem>& values,
+                      const Encoding::Options& options,
+                      const subintsplit::TuningConfig& tuning) {
+    subintsplit::TuningConfig observed = tuning;
+    auto previous = observed.selector.planObserver;
+    observed.selector.planObserver =
+        [probe, previous](
+            std::span<const subintsplit::SectionPlan> plan, bool framed) {
+          if (probe->calls++ == 0) {
+            probe->planned = Clock::now();
+            probe->plan = subintsplit::serializeSplitBoundaries(plan) +
+                (framed ? " frame" : "");
+          }
+          if (previous) {
+            previous(plan, framed);
+          }
+        };
+    probe->start = Clock::now();
+    return inner(values, options, observed);
+  };
+  constexpr int kWarmups = 2;
+  for (int rep = 0; rep < FLAGS_mlidc_sis_plan_time_reps + kWarmups; ++rep) {
+    *probe = Probe{};
+    auto target = makeTargetOrSkip<Elem>(timed, data, csv, driver, dataset);
+    const auto end = Clock::now();
+    if (target == nullptr) {
+      return;
+    }
+    const double encodeMs =
+        std::chrono::duration<double, std::milli>(end - probe->start).count();
+    const double planMs = probe->calls > 0
+        ? std::chrono::duration<double, std::milli>(
+              probe->planned - probe->start)
+              .count()
+        : -1.0;
+    std::cout << "  [plan-time] dataset=" << dataset << " arm=" << encoder.name
+              << " rep=" << (rep - kWarmups) << " plan_ms=" << planMs
+              << " encode_ms=" << encodeMs
+              << " observer_calls=" << probe->calls
+              << " bytes=" << target->payloadSize() << " plan=" << probe->plan
+              << "\n";
+  }
+}
