+
+	const SubIntSplitPlan plan = run<uint64_t>(data, 0);
+	ASSERT_EQ(plan.segments.size(), 1U);
+	EXPECT_EQ(plan.segments[0].bit_start, 0);
+	EXPECT_EQ(plan.segments[0].bit_end, 63);
+	EXPECT_DOUBLE_EQ(plan.estimated_bits, 0.0);
+}
