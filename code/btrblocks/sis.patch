+  // Zero positions and zero tuples must both be no-ops rather than crashes.
+  BIGINT sentinel = -1;
+  scheme.gather(&sentinel, compressed.get(), &nullmap, tuple_count, nullptr, 0, 0);
+  ASSERT_EQ(sentinel, -1);
+
+  const u32 position = 0;
