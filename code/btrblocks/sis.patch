+u32 LemiereImpl<Codec>::blockPackedCount(const data_t* src) const {
+  if constexpr (Codec == FastPForCodec::FBP) {
+    // Written verbatim by FastBinaryPacking<32>::encodeArray as `*out++ = length`.
